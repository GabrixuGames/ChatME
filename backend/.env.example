# ChatApp Backend Environment Variables
# Copia este archivo a .env y configura tus valores

# Flask Configuration
FLASK_SECRET_KEY=tu_clave_secreta_super_segura_aqui
JWT_SECRET=tu_jwt_super_seguro_aqui
ENVIRONMENT=development
FLASK_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_USER=chatapp
DB_PASSWORD=tu_password_db_aqui
DB_NAME=chatapp
DB_PORT=5432

# CORS Origins (para desarrollo)
# Puedes usar CORS_ALLOWED_ORIGINS o CORS_ORIGINS (ambas son compatibles)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://172.20.10.10:8080

# Rate limits globales (opcional)
# RATE_LIMITS=200 per day,50 per hour

# Para producción añadir:
# ENVIRONMENT=production
# FLASK_ENV=production
# DB_SSL_MODE=require
# CORS_ALLOWED_ORIGINS=https://tu-dominio.com
