# ChatApp Backend Environment Variables
# Copia este archivo a .env y configura tus valores

# Flask Configuration
FLASK_SECRET_KEY=tu_clave_secreta_super_segura_aqui
FLASK_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_USER=chatapp
DB_PASSWORD=tu_password_db_aqui
