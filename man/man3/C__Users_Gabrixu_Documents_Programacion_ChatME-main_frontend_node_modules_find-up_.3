.SH NAME
frontend/node_modules/find-up Directory Reference
.SH SYNOPSIS
.br
.PP
.SH "Detailed Description"
.PP 

.SH "find-up [![Build Status](https://travis-ci.com/sindresorhus/find-up.svg?branch=master)](https://travis-ci.com/github/sindresorhus/find-up)"
.PP
.RS 4
Find a file or directory by walking up parent directories 
.RE
.PP
.SH "Install"
.PP
.PP
.nf
$ npm install find\-up
.fi
.PP
.SH "Usage"
.PP
.PP
.nf
/
└── Users
    └── sindresorhus
        ├── unicorn\&.png
        └── foo
            └── bar
                ├── baz
                └── example\&.js
.fi
.PP

.PP
\fRexample\&.js\fP

.PP
.PP
.nf
const path = require('path');
const findUp = require('find\-up');

(async () => {
    console\&.log(await findUp('unicorn\&.png'));
    //=> '/Users/sindresorhus/unicorn\&.png'

    console\&.log(await findUp(['rainbow\&.png', 'unicorn\&.png']));
    //=> '/Users/sindresorhus/unicorn\&.png'

    console\&.log(await findUp(async directory => {
        const hasUnicorns = await findUp\&.exists(path\&.join(directory, 'unicorn\&.png'));
        return hasUnicorns && directory;
    }, {type: 'directory'}));
    //=> '/Users/sindresorhus'
})();
.fi
.PP
.SH "API"
.PP
.SS "findUp(name, options?)"
.SS "findUp(matcher, options?)"
Returns a \fRPromise\fP for either the path or \fRundefined\fP if it couldn't be found\&.
.SS "findUp([\&.\&.\&.name], options?)"
Returns a \fRPromise\fP for either the first path found (by respecting the order of the array) or \fRundefined\fP if none could be found\&.
.SS "findUp\&.sync(name, options?)"
.SS "findUp\&.sync(matcher, options?)"
Returns a path or \fRundefined\fP if it couldn't be found\&.
.SS "findUp\&.sync([\&.\&.\&.name], options?)"
Returns the first path found (by respecting the order of the array) or \fRundefined\fP if none could be found\&.
.SS "name"
Type: \fRstring\fP

.PP
Name of the file or directory to find\&.
.SS "matcher"
Type: \fRFunction\fP

.PP
A function that will be called with each directory until it returns a \fRstring\fP with the path, which stops the search, or the root directory has been reached and nothing was found\&. Useful if you want to match files with certain patterns, set of permissions, or other advanced use-cases\&.

.PP
When using async mode, the \fRmatcher\fP may optionally be an async or promise-returning function that returns the path\&.
.SS "options"
Type: \fRobject\fP
.SS "cwd"
Type: \fRstring\fP\\ Default: \fRprocess\&.cwd()\fP

.PP
Directory to start from\&.
.SS "type"
Type: \fRstring\fP\\ Default: \fR'file'\fP\\ Values: \fR'file'\fP \fR'directory'\fP

.PP
The type of paths that can match\&.
.SS "allowSymlinks"
Type: \fRboolean\fP\\ Default: \fRtrue\fP

.PP
Allow symbolic links to match if they point to the chosen path type\&.
.SS "findUp\&.exists(path)"
Returns a \fRPromise<boolean>\fP of whether the path exists\&.
.SS "findUp\&.sync\&.exists(path)"
Returns a \fRboolean\fP of whether the path exists\&.
.SS "path"
Type: \fRstring\fP

.PP
Path to a file or directory\&.
.SS "findUp\&.stop"
A \fR\fRSymbol\fP\fP that can be returned by a \fRmatcher\fP function to stop the search and cause \fRfindUp\fP to immediately return \fRundefined\fP\&. Useful as a performance optimization in case the current working directory is deeply nested in the filesystem\&.

.PP
.PP
.nf
const path = require('path');
const findUp = require('find\-up');

(async () => {
    await findUp(directory => {
        return path\&.basename(directory) === 'work' ? findUp\&.stop : 'logo\&.png';
    });
})();
.fi
.PP
