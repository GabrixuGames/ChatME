\fR\fP \fR\fP \fR\fP \fR\fP [][license-url] \fR\fP

.PP
\fR\fP
.PP
Helper functions around Function call/apply/bind, for use in \fRcall-bind\fP\&.

.PP
The only packages that should likely ever use this package directly are \fRcall-bind\fP and \fRget-intrinsic\fP\&. Please use \fRcall-bind\fP unless you have a very good reason not to\&.
.SH "Getting started"
.PP
.PP
.nf
npm install \-\-save call\-bind\-apply\-helpers
.fi
.PP
.SH "Usage/Examples"
.PP
.PP
.nf
const assert = require('assert');
const callBindBasic = require('call\-bind\-apply\-helpers');

function f(a, b) {
    assert\&.equal(this, 1);
    assert\&.equal(a, 2);
    assert\&.equal(b, 3);
    assert\&.equal(arguments\&.length, 2);
}

const fBound = callBindBasic([f, 1]);

delete Function\&.prototype\&.call;
delete Function\&.prototype\&.bind;

fBound(2, 3);
.fi
.PP
