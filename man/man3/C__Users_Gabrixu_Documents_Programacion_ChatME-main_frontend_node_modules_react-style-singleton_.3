.SH NAME
frontend/node_modules/react-style-singleton Directory Reference
.SH SYNOPSIS
.br
.PP
.SH "Detailed Description"
.PP 
\fB300b\fP with all dependencies, minified and gzipped

.PP
Creates a style component with internal \fItracker\fP\&.
.IP "\(bu" 2
Adds styles to the browser on the \fBfirst\fP instance mount\&.
.IP "\(bu" 2
Removes after the \fBlast\fP instance unmount\&.
.IP "\(bu" 2
Thus helps you deliver styles you need to the customer, and clean up later\&.
.IP "\(bu" 2
Is not server-side rendering compatible!
.PP
.SH "API"
.PP
.SS "Component"
.PP
.nf
import {styleSingleton} from 'react\-style\-singleton'

const Style = styleSingleton();

export const App = () => (
  <Style styles={'body {color:red}'} />
);
.fi
.PP
.SS "Hook"
.PP
.nf
import {styleHookSingleton} from 'react\-style\-singleton';

const useStyle = styleHookSingleton();
const useAnotherStyle = styleHookSingleton();

export const App = () => {
  useStyle('div {color:red}');
  useAnotherStyle('body { background\-color:red }');
  return (<div />);
}
.fi
