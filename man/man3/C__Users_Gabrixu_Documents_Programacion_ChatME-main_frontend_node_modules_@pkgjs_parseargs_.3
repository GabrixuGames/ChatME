.PP
.SS "💡 \fRprocess\&.mainArgs\fP Proposal"
.RS 4
Note: This can be moved forward independently of the \fRutil\&.parseArgs()\fP proposal/work\&. 
.RE
.PP
.SS "Implementation:"
.PP
.nf
process\&.mainArgs = process\&.argv\&.slice(process\&._exec ? 1 : 2)
.fi
.PP

.PP
.PP
.SS "📃 Examples"
.PP
.nf
const { parseArgs } = require('@pkgjs/parseargs');
.fi
.PP

.PP
.PP
.nf
const { parseArgs } = require('@pkgjs/parseargs');
// specify the options that may be used
const options = {
  foo: { type: 'string'},
  bar: { type: 'boolean' },
};
const args = ['\-\-foo=a', '\-\-bar'];
const { values, positionals } = parseArgs({ args, options });
// values = { foo: 'a', bar: true }
// positionals = []
.fi
.PP

.PP
.PP
.nf
const { parseArgs } = require('@pkgjs/parseargs');
// type:string & multiple
const options = {
  foo: {
    type: 'string',
    multiple: true,
  },
};
const args = ['\-\-foo=a', '\-\-foo', 'b'];
const { values, positionals } = parseArgs({ args, options });
// values = { foo: [ 'a', 'b' ] }
// positionals = []
.fi
.PP

.PP
.PP
.nf
const { parseArgs } = require('@pkgjs/parseargs');
// shorts
const options = {
  foo: {
    short: 'f',
    type: 'boolean'
  },
};
const args = ['\-f', 'b'];
const { values, positionals } = parseArgs({ args, options, allowPositionals: true });
// values = { foo: true }
// positionals = ['b']
.fi
.PP

.PP
.PP
.nf
const { parseArgs } = require('@pkgjs/parseargs');
// unconfigured
const options = {};
const args = ['\-f', '\-\-foo=a', '\-\-bar', 'b'];
const { values, positionals } = parseArgs({ strict: false, args, options, allowPositionals: true });
// values = { f: true, foo: 'a', bar: true }
// positionals = ['b']
.fi
.PP

