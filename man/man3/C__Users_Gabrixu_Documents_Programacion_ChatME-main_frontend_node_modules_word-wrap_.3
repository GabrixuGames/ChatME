.SH NAME
frontend/node_modules/word-wrap Directory Reference
.SH SYNOPSIS
.br
.PP
.SH "Detailed Description"
.PP 

.SH "word-wrap [![NPM version](https://img.shields.io/npm/v/word-wrap.svg?style=flat)](https://www.npmjs.com/package/word-wrap) [![NPM monthly downloads](https://img.shields.io/npm/dm/word-wrap.svg?style=flat)](https://npmjs.org/package/word-wrap) [![NPM total downloads](https://img.shields.io/npm/dt/word-wrap.svg?style=flat)](https://npmjs.org/package/word-wrap) [![Linux Build Status](https://img.shields.io/travis/jonschlinkert/word-wrap.svg?style=flat&label=Travis)](https://travis-ci.org/jonschlinkert/word-wrap)"
.PP
.RS 4
Wrap words to a specified length\&. 
.RE
.PP

.PP
Please consider following this project's author, \fRJon Schlinkert\fP, and consider starring the project to show your :heart: and support\&.
.SH "Install"
.PP
Install with \fRnpm\fP:

.PP
.PP
.nf
$ npm install \-\-save word\-wrap
.fi
.PP
.SH "Usage"
.PP
.PP
.nf
var wrap = require('word\-wrap');

wrap('Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua\&. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat\&.');
.fi
.PP

.PP
Results in:

.PP
.PP
.nf
Lorem ipsum dolor sit amet, consectetur adipiscing
elit, sed do eiusmod tempor incididunt ut labore
et dolore magna aliqua\&. Ut enim ad minim veniam,
quis nostrud exercitation ullamco laboris nisi ut
aliquip ex ea commodo consequat\&.
.fi
.PP
.SH "Options"
.PP
.SS "options\&.width"
Type: \fRNumber\fP

.PP
Default: \fR50\fP

.PP
The width of the text before wrapping to a new line\&.

.PP
\fBExample:\fP

.PP
.PP
.nf
wrap(str, {width: 60});
.fi
.PP
.SS "options\&.indent"
Type: \fRString\fP

.PP
Default: `` (two spaces)

.PP
The string to use at the beginning of each line\&.

.PP
\fBExample:\fP

.PP
.PP
.nf
wrap(str, {indent: '      '});
.fi
.PP
.SS "options\&.newline"
Type: \fRString\fP

.PP
Default: \fR\\n\fP

.PP
The string to use at the end of each line\&.

.PP
\fBExample:\fP

.PP
.PP
.nf
wrap(str, {newline: '\\n\\n'});
.fi
.PP
.SS "options\&.escape"
Type: \fRfunction\fP

.PP
Default: \fRfunction(str){return str;}\fP

.PP
An escape function to run on each line after splitting them\&.

.PP
\fBExample:\fP

.PP
.PP
.nf
var xmlescape = require('xml\-escape');
wrap(str, {
  escape: function(string){
    return xmlescape(string);
  }
});
.fi
.PP
.SS "options\&.trim"
Type: \fRBoolean\fP

.PP
Default: \fRfalse\fP

.PP
Trim trailing whitespace from the returned string\&. This option is included since \fR\&.trim()\fP would also strip the leading indentation from the first line\&.

.PP
\fBExample:\fP

.PP
.PP
.nf
wrap(str, {trim: true});
.fi
.PP
.SS "options\&.cut"
Type: \fRBoolean\fP

.PP
Default: \fRfalse\fP

.PP
Break a word between any two letters when the word is longer than the specified width\&.

.PP
\fBExample:\fP

.PP
.PP
.nf
wrap(str, {cut: true});
.fi
.PP
