.SH "Examples"
.PP
.SS "Consuming a source map"
.PP
.nf
var rawSourceMap = {
  version: 3,
  file: 'min\&.js',
  names: ['bar', 'baz', 'n'],
  sources: ['one\&.js', 'two\&.js'],
  sourceRoot: 'http://example\&.com/www/js/',
  mappings: 'CAAC,IAAI,IAAM,SAAUA,GAClB,OAAOC,IAAID;CCDb,IAAI,IAAM,SAAUE,GAClB,OAAOA'
};

var smc = new SourceMapConsumer(rawSourceMap);

console\&.log(smc\&.sources);
// [ 'http://example\&.com/www/js/one\&.js',
//   'http://example\&.com/www/js/two\&.js' ]

console\&.log(smc\&.originalPositionFor({
  line: 2,
  column: 28
}));
// { source: 'http://example\&.com/www/js/two\&.js',
//   line: 2,
//   column: 10,
//   name: 'n' }

console\&.log(smc\&.generatedPositionFor({
  source: 'http://example\&.com/www/js/two\&.js',
  line: 2,
  column: 10
}));
// { line: 2, column: 28 }

smc\&.eachMapping(function (m) {
  // \&.\&.\&.
});
.fi
.PP
.SS "Generating a source map"
In depth guide: \fR\fBCompiling to JavaScript, and Debugging with Source Maps\fP\fP
.SS "With SourceNode (high level API)"
.PP
.nf
function compile(ast) {
  switch (ast\&.type) {
  case 'BinaryExpression':
    return new SourceNode(
      ast\&.location\&.line,
      ast\&.location\&.column,
      ast\&.location\&.source,
      [compile(ast\&.left), " + ", compile(ast\&.right)]
    );
  case 'Literal':
    return new SourceNode(
      ast\&.location\&.line,
      ast\&.location\&.column,
      ast\&.location\&.source,
      String(ast\&.value)
    );
  // \&.\&.\&.
  default:
    throw new Error("Bad AST");
  }
}

var ast = parse("40 + 2", "add\&.js");
console\&.log(compile(ast)\&.toStringWithSourceMap({
  file: 'add\&.js'
}));
// { code: '40 + 2',
//   map: [object SourceMapGenerator] }
.fi
.PP
.SS "With SourceMapGenerator (low level API)"
.PP
.nf
var map = new SourceMapGenerator({
  file: "source\-mapped\&.js"
});

map\&.addMapping({
  generated: {
    line: 10,
    column: 35
  },
  source: "foo\&.js",
  original: {
    line: 33,
    column: 2
  },
  name: "christopher"
});

console\&.log(map\&.toString());
// '{"version":3,"file":"source\-mapped\&.js","sources":["foo\&.js"],"names":["christopher"],"mappings":";;;;;;;;;mCAgCEA"}'
.fi
.PP
.SH "API"
.PP
Get a reference to the module:

.PP
.PP
.nf
// Node\&.js
var sourceMap = require('source\-map');

// Browser builds
var sourceMap = window\&.sourceMap;

// Inside Firefox
const sourceMap = require("devtools/toolkit/sourcemap/source\-map\&.js");
.fi
.PP
.SS "SourceMapConsumer"
A SourceMapConsumer instance represents a parsed source map which we can query for information about the original file positions by giving it a file position in the generated source\&.
.SS "new SourceMapConsumer(rawSourceMap)"
The only parameter is the raw source map (either as a string which can be \fRJSON\&.parse\fP'd, or an object)\&. According to the spec, source maps have the following attributes:

.PP
.IP "\(bu" 2
\fRversion\fP: Which version of the source map spec this map is following\&.
.IP "\(bu" 2
\fRsources\fP: An array of URLs to the original source files\&.
.IP "\(bu" 2
\fRnames\fP: An array of identifiers which can be referenced by individual mappings\&.
.IP "\(bu" 2
\fRsourceRoot\fP: Optional\&. The URL root from which all sources are relative\&.
.IP "\(bu" 2
\fRsourcesContent\fP: Optional\&. An array of contents of the original source files\&.
.IP "\(bu" 2
\fRmappings\fP: A string of base64 VLQs which contain the actual mappings\&.
.IP "\(bu" 2
\fRfile\fP: Optional\&. The generated filename this source map is associated with\&.
.PP

.PP
.PP
.nf
var consumer = new sourceMap\&.SourceMapConsumer(rawSourceMapJsonData);
.fi
.PP
.SS "SourceMapConsumer\&.prototype\&.computeColumnSpans()"
Compute the last column for each generated mapping\&. The last column is inclusive\&.

.PP
.PP
.nf
// Before:
consumer\&.allGeneratedPositionsFor({ line: 2, source: "foo\&.coffee" })
// [ { line: 2,
//     column: 1 },
//   { line: 2,
//     column: 10 },
//   { line: 2,
//     column: 20 } ]

consumer\&.computeColumnSpans();

// After:
consumer\&.allGeneratedPositionsFor({ line: 2, source: "foo\&.coffee" })
// [ { line: 2,
//     column: 1,
//     lastColumn: 9 },
//   { line: 2,
//     column: 10,
//     lastColumn: 19 },
//   { line: 2,
//     column: 20,
//     lastColumn: Infinity } ]
.fi
.PP
.SS "SourceMapConsumer\&.prototype\&.originalPositionFor(generatedPosition)"
Returns the original source, line, and column information for the generated source's line and column positions provided\&. The only argument is an object with the following properties:

.PP
.IP "\(bu" 2
\fRline\fP: The line number in the generated source\&. Line numbers in this library are 1-based (note that the underlying source map specification uses 0-based line numbers -- this library handles the translation)\&.
.IP "\(bu" 2
\fRcolumn\fP: The column number in the generated source\&. Column numbers in this library are 0-based\&.
.IP "\(bu" 2
\fRbias\fP: Either \fRSourceMapConsumer\&.GREATEST_LOWER_BOUND\fP or \fRSourceMapConsumer\&.LEAST_UPPER_BOUND\fP\&. Specifies whether to return the closest element that is smaller than or greater than the one we are searching for, respectively, if the exact element cannot be found\&. Defaults to \fRSourceMapConsumer\&.GREATEST_LOWER_BOUND\fP\&.
.PP

.PP
and an object is returned with the following properties:

.PP
.IP "\(bu" 2
\fRsource\fP: The original source file, or null if this information is not available\&.
.IP "\(bu" 2
\fRline\fP: The line number in the original source, or null if this information is not available\&. The line number is 1-based\&.
.IP "\(bu" 2
\fRcolumn\fP: The column number in the original source, or null if this information is not available\&. The column number is 0-based\&.
.IP "\(bu" 2
\fRname\fP: The original identifier, or null if this information is not available\&.
.PP

.PP
.PP
.nf
consumer\&.originalPositionFor({ line: 2, column: 10 })
// { source: 'foo\&.coffee',
//   line: 2,
//   column: 2,
//   name: null }

consumer\&.originalPositionFor({ line: 99999999999999999, column: 999999999999999 })
// { source: null,
//   line: null,
//   column: null,
//   name: null }
.fi
.PP
.SS "SourceMapConsumer\&.prototype\&.generatedPositionFor(originalPosition)"
Returns the generated line and column information for the original source, line, and column positions provided\&. The only argument is an object with the following properties:

.PP
.IP "\(bu" 2
\fRsource\fP: The filename of the original source\&.
.IP "\(bu" 2
\fRline\fP: The line number in the original source\&. The line number is 1-based\&.
.IP "\(bu" 2
\fRcolumn\fP: The column number in the original source\&. The column number is 0-based\&.
.PP

.PP
and an object is returned with the following properties:

.PP
.IP "\(bu" 2
\fRline\fP: The line number in the generated source, or null\&. The line number is 1-based\&.
.IP "\(bu" 2
\fRcolumn\fP: The column number in the generated source, or null\&. The column number is 0-based\&.
.PP

.PP
.PP
.nf
consumer\&.generatedPositionFor({ source: "example\&.js", line: 2, column: 10 })
// { line: 1,
//   column: 56 }
.fi
.PP
.SS "SourceMapConsumer\&.prototype\&.allGeneratedPositionsFor(originalPosition)"
Returns all generated line and column information for the original source, line, and column provided\&. If no column is provided, returns all mappings corresponding to a either the line we are searching for or the next closest line that has any mappings\&. Otherwise, returns all mappings corresponding to the given line and either the column we are searching for or the next closest column that has any offsets\&.

.PP
The only argument is an object with the following properties:

.PP
.IP "\(bu" 2
\fRsource\fP: The filename of the original source\&.
.IP "\(bu" 2
\fRline\fP: The line number in the original source\&. The line number is 1-based\&.
.IP "\(bu" 2
\fRcolumn\fP: Optional\&. The column number in the original source\&. The column number is 0-based\&.
.PP

.PP
and an array of objects is returned, each with the following properties:

.PP
.IP "\(bu" 2
\fRline\fP: The line number in the generated source, or null\&. The line number is 1-based\&.
.IP "\(bu" 2
\fRcolumn\fP: The column number in the generated source, or null\&. The column number is 0-based\&.
.PP

.PP
.PP
.nf
consumer\&.allGeneratedpositionsfor({ line: 2, source: "foo\&.coffee" })
// [ { line: 2,
//     column: 1 },
//   { line: 2,
//     column: 10 },
//   { line: 2,
//     column: 20 } ]
.fi
.PP
.SS "SourceMapConsumer\&.prototype\&.hasContentsOfAllSources()"
Return true if we have the embedded source content for every source listed in the source map, false otherwise\&.

.PP
In other words, if this method returns \fRtrue\fP, then \fRconsumer\&.sourceContentFor(s)\fP will succeed for every source \fRs\fP in \fRconsumer\&.sources\fP\&.

.PP
.PP
.nf
// \&.\&.\&.
if (consumer\&.hasContentsOfAllSources()) {
  consumerReadyCallback(consumer);
} else {
  fetchSources(consumer, consumerReadyCallback);
}
// \&.\&.\&.
.fi
.PP
.SS "SourceMapConsumer\&.prototype\&.sourceContentFor(source[, returnNullOnMissing])"
Returns the original source content for the source provided\&. The only argument is the URL of the original source file\&.

.PP
If the source content for the given source is not found, then an error is thrown\&. Optionally, pass \fRtrue\fP as the second param to have \fRnull\fP returned instead\&.

.PP
.PP
.nf
consumer\&.sources
// [ "my\-cool\-lib\&.clj" ]

consumer\&.sourceContentFor("my\-cool\-lib\&.clj")
// "\&.\&.\&."

consumer\&.sourceContentFor("this is not in the source map");
// Error: "this is not in the source map" is not in the source map

consumer\&.sourceContentFor("this is not in the source map", true);
// null
.fi
.PP
.SS "SourceMapConsumer\&.prototype\&.eachMapping(callback, context, order)"
Iterate over each mapping between an original source/line/column and a generated line/column in this source map\&.

.PP
.IP "\(bu" 2
\fRcallback\fP: The function that is called with each mapping\&. Mappings have the form \fR{ source, generatedLine, generatedColumn, originalLine, originalColumn, name }\fP
.IP "\(bu" 2
\fRcontext\fP: Optional\&. If specified, this object will be the value of \fRthis\fP every time that \fRcallback\fP is called\&.
.IP "\(bu" 2
\fRorder\fP: Either \fRSourceMapConsumer\&.GENERATED_ORDER\fP or \fRSourceMapConsumer\&.ORIGINAL_ORDER\fP\&. Specifies whether you want to iterate over the mappings sorted by the generated file's line/column order or the original's source/line/column order, respectively\&. Defaults to \fRSourceMapConsumer\&.GENERATED_ORDER\fP\&.
.PP

.PP
.PP
.nf
consumer\&.eachMapping(function (m) { console\&.log(m); })
// \&.\&.\&.
// { source: 'illmatic\&.js',
//   generatedLine: 1,
//   generatedColumn: 0,
//   originalLine: 1,
//   originalColumn: 0,
//   name: null }
// { source: 'illmatic\&.js',
//   generatedLine: 2,
//   generatedColumn: 0,
//   originalLine: 2,
//   originalColumn: 0,
//   name: null }
// \&.\&.\&.
.fi
.PP
 
.SS "SourceMapGenerator"
An instance of the SourceMapGenerator represents a source map which is being built incrementally\&.
.SS "new SourceMapGenerator([startOfSourceMap])"
You may pass an object with the following properties:

.PP
.IP "\(bu" 2
\fRfile\fP: The filename of the generated source that this source map is associated with\&.
.IP "\(bu" 2
\fRsourceRoot\fP: A root for all relative URLs in this source map\&.
.IP "\(bu" 2
\fRskipValidation\fP: Optional\&. When \fRtrue\fP, disables validation of mappings as they are added\&. This can improve performance but should be used with discretion, as a last resort\&. Even then, one should avoid using this flag when running tests, if possible\&.
.IP "\(bu" 2
\fRignoreInvalidMapping\fP: Optional\&. When \fRtrue\fP, instead of throwing error on invalid mapping, it will be ignored\&.
.PP

.PP
.PP
.nf
var generator = new sourceMap\&.SourceMapGenerator({
  file: "my\-generated\-javascript\-file\&.js",
  sourceRoot: "http://example\&.com/app/js/"
});
.fi
.PP
.SS "SourceMapGenerator\&.fromSourceMap(sourceMapConsumer, sourceMapGeneratorOptions)"
Creates a new \fRSourceMapGenerator\fP from an existing \fRSourceMapConsumer\fP instance\&.

.PP
.IP "\(bu" 2
\fRsourceMapConsumer\fP The SourceMap\&.
.IP "\(bu" 2
\fRsourceMapGeneratorOptions\fP options that will be passed to the SourceMapGenerator constructor which used under the hood\&.
.PP

.PP
.PP
.nf
var generator = sourceMap\&.SourceMapGenerator\&.fromSourceMap(consumer, {
  ignoreInvalidMapping: true,
});
.fi
.PP
.SS "SourceMapGenerator\&.prototype\&.addMapping(mapping)"
Add a single mapping from original source line and column to the generated source's line and column for this source map being created\&. The mapping object should have the following properties:

.PP
.IP "\(bu" 2
\fRgenerated\fP: An object with the generated line and column positions\&.
.IP "\(bu" 2
\fRoriginal\fP: An object with the original line and column positions\&.
.IP "\(bu" 2
\fRsource\fP: The original source file (relative to the sourceRoot)\&.
.IP "\(bu" 2
\fRname\fP: An optional original token name for this mapping\&.
.PP

.PP
.PP
.nf
generator\&.addMapping({
  source: "module\-one\&.scm",
  original: { line: 128, column: 0 },
  generated: { line: 3, column: 456 }
})
.fi
.PP
.SS "SourceMapGenerator\&.prototype\&.setSourceContent(sourceFile, sourceContent)"
Set the source content for an original source file\&.

.PP
.IP "\(bu" 2
\fRsourceFile\fP the URL of the original source file\&.
.IP "\(bu" 2
\fRsourceContent\fP the content of the source file\&.
.PP

.PP
.PP
.nf
generator\&.setSourceContent("module\-one\&.scm",
                           fs\&.readFileSync("path/to/module\-one\&.scm"))
.fi
.PP
.SS "SourceMapGenerator\&.prototype\&.applySourceMap(sourceMapConsumer[, sourceFile[, sourceMapPath]])"
Applies a SourceMap for a source file to the SourceMap\&. Each mapping to the supplied source file is rewritten using the supplied SourceMap\&. Note: The resolution for the resulting mappings is the minimum of this map and the supplied map\&.

.PP
.IP "\(bu" 2
\fRsourceMapConsumer\fP: The SourceMap to be applied\&.
.IP "\(bu" 2
\fRsourceFile\fP: Optional\&. The filename of the source file\&. If omitted, sourceMapConsumer\&.file will be used, if it exists\&. Otherwise an error will be thrown\&.
.IP "\(bu" 2
\fRsourceMapPath\fP: Optional\&. The dirname of the path to the SourceMap to be applied\&. If relative, it is relative to the SourceMap\&.

.PP
This parameter is needed when the two SourceMaps aren't in the same directory, and the SourceMap to be applied contains relative source paths\&. If so, those relative source paths need to be rewritten relative to the SourceMap\&.

.PP
If omitted, it is assumed that both SourceMaps are in the same directory, thus not needing any rewriting\&. (Supplying \fR'\&.'\fP has the same effect\&.)
.PP
.SS "SourceMapGenerator\&.prototype\&.toString()"
Renders the source map being generated to a string\&.

.PP
.PP
.nf
generator\&.toString()
// '{"version":3,"sources":["module\-one\&.scm"],"names":[],"mappings":"\&.\&.\&.snip\&.\&.\&.","file":"my\-generated\-javascript\-file\&.js","sourceRoot":"http://example\&.com/app/js/"}'
.fi
.PP
.SS "SourceNode"
SourceNodes provide a way to abstract over interpolating and/or concatenating snippets of generated JavaScript source code, while maintaining the line and column information associated between those snippets and the original source code\&. This is useful as the final intermediate representation a compiler might use before outputting the generated JS and source map\&.
.SS "new SourceNode([line, column, source[, chunk[, name]]])"
.IP "\(bu" 2
\fRline\fP: The original line number associated with this source node, or null if it isn't associated with an original line\&. The line number is 1-based\&.
.IP "\(bu" 2
\fRcolumn\fP: The original column number associated with this source node, or null if it isn't associated with an original column\&. The column number is 0-based\&.
.IP "\(bu" 2
\fRsource\fP: The original source's filename; null if no filename is provided\&.
.IP "\(bu" 2
\fRchunk\fP: Optional\&. Is immediately passed to \fRSourceNode\&.prototype\&.add\fP, see below\&.
.IP "\(bu" 2
\fRname\fP: Optional\&. The original identifier\&.
.PP

.PP
.PP
.nf
var node = new SourceNode(1, 2, "a\&.cpp", [
  new SourceNode(3, 4, "b\&.cpp", "extern int status;\\n"),
  new SourceNode(5, 6, "c\&.cpp", "std::string* make_string(size_t n);\\n"),
  new SourceNode(7, 8, "d\&.cpp", "int main(int argc, char** argv) {}\\n"),
]);
.fi
.PP
.SS "SourceNode\&.fromStringWithSourceMap(code, sourceMapConsumer[, relativePath])"
Creates a SourceNode from generated code and a SourceMapConsumer\&.

.PP
.IP "\(bu" 2
\fRcode\fP: The generated code
.IP "\(bu" 2
\fRsourceMapConsumer\fP The SourceMap for the generated code
.IP "\(bu" 2
\fRrelativePath\fP The optional path that relative sources in \fRsourceMapConsumer\fP should be relative to\&.
.PP

.PP
.PP
.nf
var consumer = new SourceMapConsumer(fs\&.readFileSync("path/to/my\-file\&.js\&.map", "utf8"));
var node = SourceNode\&.fromStringWithSourceMap(fs\&.readFileSync("path/to/my\-file\&.js"),
                                              consumer);
.fi
.PP
.SS "SourceNode\&.prototype\&.add(chunk)"
Add a chunk of generated JS to this source node\&.

.PP
.IP "\(bu" 2
\fRchunk\fP: A string snippet of generated JS code, another instance of \fRSourceNode\fP, or an array where each member is one of those things\&.
.PP

.PP
.PP
.nf
node\&.add(" + ");
node\&.add(otherNode);
node\&.add([leftHandOperandNode, " + ", rightHandOperandNode]);
.fi
.PP
.SS "SourceNode\&.prototype\&.prepend(chunk)"
Prepend a chunk of generated JS to this source node\&.

.PP
.IP "\(bu" 2
\fRchunk\fP: A string snippet of generated JS code, another instance of \fRSourceNode\fP, or an array where each member is one of those things\&.
.PP

.PP
.PP
.nf
node\&.prepend("/** Build Id: f783haef86324gf **/\\n\\n");
.fi
.PP
.SS "SourceNode\&.prototype\&.setSourceContent(sourceFile, sourceContent)"
Set the source content for a source file\&. This will be added to the \fRSourceMap\fP in the \fRsourcesContent\fP field\&.

.PP
.IP "\(bu" 2
\fRsourceFile\fP: The filename of the source file
.IP "\(bu" 2
\fRsourceContent\fP: The content of the source file
.PP

.PP
.PP
.nf
node\&.setSourceContent("module\-one\&.scm",
                      fs\&.readFileSync("path/to/module\-one\&.scm"))
.fi
.PP
.SS "SourceNode\&.prototype\&.walk(fn)"
Walk over the tree of JS snippets in this node and its children\&. The walking function is called once for each snippet of JS and is passed that snippet and the its original associated source's line/column location\&.

.PP
.IP "\(bu" 2
\fRfn\fP: The traversal function\&.
.PP

.PP
.PP
.nf
var node = new SourceNode(1, 2, "a\&.js", [
  new SourceNode(3, 4, "b\&.js", "uno"),
  "dos",
  [
    "tres",
    new SourceNode(5, 6, "c\&.js", "quatro")
  ]
]);

node\&.walk(function (code, loc) { console\&.log("WALK:", code, loc); })
// WALK: uno { source: 'b\&.js', line: 3, column: 4, name: null }
// WALK: dos { source: 'a\&.js', line: 1, column: 2, name: null }
// WALK: tres { source: 'a\&.js', line: 1, column: 2, name: null }
// WALK: quatro { source: 'c\&.js', line: 5, column: 6, name: null }
.fi
.PP
.SS "SourceNode\&.prototype\&.walkSourceContents(fn)"
Walk over the tree of SourceNodes\&. The walking function is called for each source file content and is passed the filename and source content\&.

.PP
.IP "\(bu" 2
\fRfn\fP: The traversal function\&.
.PP

.PP
.PP
.nf
var a = new SourceNode(1, 2, "a\&.js", "generated from a");
a\&.setSourceContent("a\&.js", "original a");
var b = new SourceNode(1, 2, "b\&.js", "generated from b");
b\&.setSourceContent("b\&.js", "original b");
var c = new SourceNode(1, 2, "c\&.js", "generated from c");
c\&.setSourceContent("c\&.js", "original c");

var node = new SourceNode(null, null, null, [a, b, c]);
node\&.walkSourceContents(function (source, contents) { console\&.log("WALK:", source, ":", contents); })
// WALK: a\&.js : original a
// WALK: b\&.js : original b
// WALK: c\&.js : original c
.fi
.PP
.SS "SourceNode\&.prototype\&.join(sep)"
Like \fRArray\&.prototype\&.join\fP except for SourceNodes\&. Inserts the separator between each of this source node's children\&.

.PP
.IP "\(bu" 2
\fRsep\fP: The separator\&.
.PP

.PP
.PP
.nf
var lhs = new SourceNode(1, 2, "a\&.rs", "my_copy");
var operand = new SourceNode(3, 4, "a\&.rs", "=");
var rhs = new SourceNode(5, 6, "a\&.rs", "orig\&.clone()");

var node = new SourceNode(null, null, null, [ lhs, operand, rhs ]);
var joinedNode = node\&.join(" ");
.fi
.PP
.SS "SourceNode\&.prototype\&.replaceRight(pattern, replacement)"
Call \fRString\&.prototype\&.replace\fP on the very right-most source snippet\&. Useful for trimming white space from the end of a source node, etc\&.

.PP
.IP "\(bu" 2
\fRpattern\fP: The pattern to replace\&.
.IP "\(bu" 2
\fRreplacement\fP: The thing to replace the pattern with\&.
.PP

.PP
.PP
.nf
// Trim trailing white space\&.
node\&.replaceRight(/\\s*$/, "");
.fi
.PP
.SS "SourceNode\&.prototype\&.toString()"
Return the string representation of this source node\&. Walks over the tree and concatenates all the various snippets together to one string\&.

.PP
.PP
.nf
var node = new SourceNode(1, 2, "a\&.js", [
  new SourceNode(3, 4, "b\&.js", "uno"),
  "dos",
  [
    "tres",
    new SourceNode(5, 6, "c\&.js", "quatro")
  ]
]);

node\&.toString()
// 'unodostresquatro'
.fi
.PP
.SS "SourceNode\&.prototype\&.toStringWithSourceMap([startOfSourceMap])"
Returns the string representation of this tree of source nodes, plus a SourceMapGenerator which contains all the mappings between the generated and original sources\&.

.PP
The arguments are the same as those to \fRnew SourceMapGenerator\fP\&.

.PP
.PP
.nf
var node = new SourceNode(1, 2, "a\&.js", [
  new SourceNode(3, 4, "b\&.js", "uno"),
  "dos",
  [
    "tres",
    new SourceNode(5, 6, "c\&.js", "quatro")
  ]
]);

node\&.toStringWithSourceMap({ file: "my\-output\-file\&.js" })
// { code: 'unodostresquatro',
//   map: [object SourceMapGenerator] }
.fi
.PP
 
