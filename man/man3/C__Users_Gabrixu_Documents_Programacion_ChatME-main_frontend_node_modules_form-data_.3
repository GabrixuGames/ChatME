.SH NAME
frontend/node_modules/form-data Directory Reference
.SH SYNOPSIS
.br
.PP
.SH "Detailed Description"
.PP 

.SH "Form-Data [![NPM Module](https://img.shields.io/npm/v/form-data.svg)](https://www.npmjs.com/package/form-data) [![Join the chat at https://gitter.im/form-data/form-data](http://form-data.github.io/images/gitterbadge.svg)](https://gitter.im/form-data/form-data)"
.PP
A library to create readable \fR"multipart/form-data"\fP streams\&. Can be used to submit forms and file uploads to other web applications\&.

.PP
The API of this library is inspired by the \fRXMLHttpRequest-2 FormData Interface\fP\&.

.PP
\fR\fP \fR\fP \fR\fP

.PP
\fR\fP \fR\fP
.SH "Install"
.PP
.PP
.nf
npm install \-\-save form\-data
.fi
.PP
.SH "Usage"
.PP
In this example we are constructing a form with 3 fields that contain a string, a buffer and a file stream\&.

.PP
.PP
.nf
 javascript
var FormData = require('form\-data');
var fs = require('fs');

var form = new FormData();
form\&.append('my_field', 'my value');
form\&.append('my_buffer', new Buffer(10));
form\&.append('my_file', fs\&.createReadStream('/foo/bar\&.jpg'));
.fi
.PP

.PP
Also you can use http-response stream:

.PP
.PP
.nf
 javascript
var FormData = require('form\-data');
var http = require('http');

var form = new FormData();

http\&.request('http://nodejs\&.org/images/logo\&.png', function (response) {
  form\&.append('my_field', 'my value');
  form\&.append('my_buffer', new Buffer(10));
  form\&.append('my_logo', response);
});
.fi
.PP

.PP
Or @mikeal's \fRrequest\fP stream:

.PP
.PP
.nf
 javascript
var FormData = require('form\-data');
var request = require('request');

var form = new FormData();

form\&.append('my_field', 'my value');
form\&.append('my_buffer', new Buffer(10));
form\&.append('my_logo', request('http://nodejs\&.org/images/logo\&.png'));
.fi
.PP

.PP
In order to submit this form to a web application, call \fRsubmit(url, [callback])\fP method:

.PP
.PP
.nf
 javascript
form\&.submit('http://example\&.org/', function (err, res) {
  // res – response object (http\&.IncomingMessage)  //
  res\&.resume();
});
.fi
.PP

.PP
For more advanced request manipulations \fRsubmit()\fP method returns \fRhttp\&.ClientRequest\fP object, or you can choose from one of the alternative submission methods\&.
.SS "Custom options"
You can provide custom options, such as \fRmaxDataSize\fP:

.PP
.PP
.nf
 javascript
var FormData = require('form\-data');

var form = new FormData({ maxDataSize: 20971520 });
form\&.append('my_field', 'my value');
form\&.append('my_buffer', /* something big */);
.fi
.PP

.PP
List of available options could be found in \fRcombined-stream\fP
.SS "Alternative submission methods"
You can use node's http client interface:

.PP
.PP
.nf
 javascript
var http = require('http');

var request = http\&.request({
  method: 'post',
  host: 'example\&.org',
  path: '/upload',
  headers: form\&.getHeaders()
});

form\&.pipe(request);

request\&.on('response', function (res) {
  console\&.log(res\&.statusCode);
});
.fi
.PP

.PP
Or if you would prefer the \fR'Content-Length'\fP header to be set for you:

.PP
.PP
.nf
 javascript
form\&.submit('example\&.org/upload', function (err, res) {
  console\&.log(res\&.statusCode);
});
.fi
.PP

.PP
To use custom headers and pre-known length in parts:

.PP
.PP
.nf
 javascript
var CRLF = '\\r\\n';
var form = new FormData();

var options = {
  header: CRLF + '\-\-' + form\&.getBoundary() + CRLF + 'X\-Custom\-Header: 123' + CRLF + CRLF,
  knownLength: 1
};

form\&.append('my_buffer', buffer, options);

form\&.submit('http://example\&.com/', function (err, res) {
  if (err) throw err;
  console\&.log('Done');
});
.fi
.PP

.PP
Form-Data can recognize and fetch all the required information from common types of streams (\fRfs\&.readStream\fP, \fRhttp\&.response\fP and \fRmikeal's request\fP), for some other types of streams you'd need to provide "file"-related information manually:

.PP
.PP
.nf
 javascript
someModule\&.stream(function (err, stdout, stderr) {
  if (err) throw err;

  var form = new FormData();

  form\&.append('file', stdout, {
    filename: 'unicycle\&.jpg', // \&.\&.\&. or:
    filepath: 'photos/toys/unicycle\&.jpg',
    contentType: 'image/jpeg',
    knownLength: 19806
  });

  form\&.submit('http://example\&.com/', function (err, res) {
    if (err) throw err;
    console\&.log('Done');
  });
});
.fi
.PP

.PP
The \fRfilepath\fP property overrides \fRfilename\fP and may contain a relative path\&. This is typically used when uploading \fRmultiple files from a directory\fP\&.

.PP
For edge cases, like POST request to URL with query string or to pass HTTP auth credentials, object can be passed to \fRform\&.submit()\fP as first parameter:

.PP
.PP
.nf
 javascript
form\&.submit({
  host: 'example\&.com',
  path: '/probably\&.php?extra=params',
  auth: 'username:password'
}, function (err, res) {
  console\&.log(res\&.statusCode);
});
.fi
.PP

.PP
In case you need to also send custom HTTP headers with the POST request, you can use the \fRheaders\fP key in first parameter of \fRform\&.submit()\fP:

.PP
.PP
.nf
 javascript
form\&.submit({
  host: 'example\&.com',
  path: '/surelynot\&.php',
  headers: { 'x\-test\-header': 'test\-header\-value' }
}, function (err, res) {
  console\&.log(res\&.statusCode);
});
.fi
.PP
.SS "Methods"
.IP "\(bu" 2
\fR\fIVoid\fP append( \fBString\fP \fIfield\fP, \fBMixed\fP \fIvalue\fP [, \fBMixed\fP \fIoptions\fP] )\fP\&.
.IP "\(bu" 2
\fR\fIHeaders\fP getHeaders( [\fBHeaders\fP \fIuserHeaders\fP] )\fP
.IP "\(bu" 2
\fR\fIString\fP getBoundary()\fP
.IP "\(bu" 2
\fR\fIVoid\fP setBoundary()\fP
.IP "\(bu" 2
\fR\fIBuffer\fP getBuffer()\fP
.IP "\(bu" 2
\fR\fIInteger\fP getLengthSync()\fP
.IP "\(bu" 2
\fR\fIInteger\fP getLength( \fBfunction\fP \fIcallback\fP )\fP
.IP "\(bu" 2
\fR\fIBoolean\fP hasKnownLength()\fP
.IP "\(bu" 2
\fR\fIRequest\fP submit( \fIparams\fP, \fBfunction\fP \fIcallback\fP )\fP
.IP "\(bu" 2
\fR\fIString\fP toString()\fP
.PP
.SS "\fIVoid\fP append( \fBString\fP \fIfield\fP, \fBMixed\fP \fIvalue\fP [, \fBMixed\fP \fIoptions\fP] )"
Append data to the form\&. You can submit about any format (string, integer, boolean, buffer, etc\&.)\&. However, Arrays are not supported and need to be turned into strings by the user\&. 
.PP
.nf
var form = new FormData();
form\&.append('my_string', 'my value');
form\&.append('my_integer', 1);
form\&.append('my_boolean', true);
form\&.append('my_buffer', new Buffer(10));
form\&.append('my_array_as_json', JSON\&.stringify(['bird', 'cute']));

.fi
.PP

.PP
You may provide a string for options, or an object\&. 
.PP
.nf
// Set filename by providing a string for options
form\&.append('my_file', fs\&.createReadStream('/foo/bar\&.jpg'), 'bar\&.jpg');

// provide an object\&.
form\&.append('my_file', fs\&.createReadStream('/foo/bar\&.jpg'), { filename: 'bar\&.jpg', contentType: 'image/jpeg', knownLength: 19806 });

.fi
.PP
.SS "\fIHeaders\fP getHeaders( [\fBHeaders\fP \fIuserHeaders\fP] )"
This method adds the correct \fRcontent-type\fP header to the provided array of \fRuserHeaders\fP\&.
.SS "\fIString\fP getBoundary()"
Return the boundary of the formData\&. By default, the boundary consists of 26 \fR-\fP followed by 24 numbers for example: 
.PP
.nf
\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-515890814546601021194782

.fi
.PP
.SS "\fIVoid\fP setBoundary(String \fIboundary\fP)"
Set the boundary string, overriding the default behavior described above\&.

.PP
\fINote: The boundary must be unique and may not appear in the data\&.\fP
.SS "\fIBuffer\fP getBuffer()"
Return the full formdata request package, as a Buffer\&. You can insert this Buffer in e\&.g\&. Axios to send multipart data\&. 
.PP
.nf
var form = new FormData();
form\&.append('my_buffer', Buffer\&.from([0x4a,0x42,0x20,0x52,0x6f,0x63,0x6b,0x73]));
form\&.append('my_file', fs\&.readFileSync('/foo/bar\&.jpg'));

axios\&.post('https://example\&.com/path/to/api', form\&.getBuffer(), form\&.getHeaders());

.fi
.PP
 \fBNote:\fP Because the output is of type Buffer, you can only append types that are accepted by Buffer: \fIstring, Buffer, ArrayBuffer, Array, or Array-like Object\fP\&. A ReadStream for example will result in an error\&.
.SS "\fIInteger\fP getLengthSync()"
Same as \fRgetLength\fP but synchronous\&.

.PP
\fINote: getLengthSync \fBdoesn't\fP calculate streams length\&.\fP
.SS "\fIInteger\fP getLength(\fBfunction\fP \fIcallback\fP )"
Returns the \fRContent-Length\fP async\&. The callback is used to handle errors and continue once the length has been calculated 
.PP
.nf
this\&.getLength(function (err, length) {
  if (err) {
    this\&._error(err);
    return;
  }

  // add content length
  request\&.setHeader('Content\-Length', length);

  \&.\&.\&.
}\&.bind(this));

.fi
.PP
.SS "\fIBoolean\fP hasKnownLength()"
Checks if the length of added values is known\&.
.SS "\fIRequest\fP submit(\fIparams\fP, \fBfunction\fP \fIcallback\fP )"
Submit the form to a web application\&. 
.PP
.nf
var form = new FormData();
form\&.append('my_string', 'Hello World');

form\&.submit('http://example\&.com/', function (err, res) {
  // res – response object (http\&.IncomingMessage)  //
  res\&.resume();
} );

.fi
.PP
.SS "\fIString\fP toString()"
Returns the form data as a string\&. Don't use this if you are sending files or buffers, use \fRgetBuffer()\fP instead\&.
.SS "Integration with other libraries"
.SS "Request"
Form submission using \fRrequest\fP:

.PP
.PP
.nf
var formData = {
  my_field: 'my_value',
  my_file: fs\&.createReadStream(__dirname + '/unicycle\&.jpg'),
};

request\&.post({url:'http://service\&.com/upload', formData: formData}, function (err, httpResponse, body) {
  if (err) {
    return console\&.error('upload failed:', err);
  }
  console\&.log('Upload successful!  Server responded with:', body);
});
.fi
.PP

.PP
For more details see \fRrequest readme\fP\&.
.SS "node-fetch"
You can also submit a form using \fRnode-fetch\fP:

.PP
.PP
.nf
var form = new FormData();

form\&.append('a', 1);

fetch('http://example\&.com', { method: 'POST', body: form })
    \&.then(function (res) {
        return res\&.json();
    })\&.then(function (json) {
        console\&.log(json);
    });
.fi
.PP
.SS "axios"
In Node\&.js you can post a file using \fRaxios\fP: 
.PP
.nf
const form = new FormData();
const stream = fs\&.createReadStream(PATH_TO_FILE);

form\&.append('image', stream);

// In Node\&.js environment you need to set boundary in the header field 'Content\-Type' by calling method `getHeaders`
const formHeaders = form\&.getHeaders();

axios\&.post('http://example\&.com', form, {
  headers: {
    \&.\&.\&.formHeaders,
  },
})
  \&.then(response => response)
  \&.catch(error => error)

.fi
.PP
.SH "Notes"
.PP
.IP "\(bu" 2
\fRgetLengthSync()\fP method DOESN'T calculate length for streams, use \fRknownLength\fP options as workaround\&.
.IP "\(bu" 2
\fRgetLength(cb)\fP will send an error as first parameter of callback if stream length cannot be calculated (e\&.g\&. send in custom streams w/o using \fRknownLength\fP)\&.
.IP "\(bu" 2
\fRsubmit\fP will not add \fRcontent-length\fP if form length is unknown or not calculable\&.
.IP "\(bu" 2
Starting version \fR2\&.x\fP FormData has dropped support for \fRnode@0\&.10\&.x\fP\&.
.IP "\(bu" 2
Starting version \fR3\&.x\fP FormData has dropped support for \fRnode@4\&.x\fP\&.
.PP
