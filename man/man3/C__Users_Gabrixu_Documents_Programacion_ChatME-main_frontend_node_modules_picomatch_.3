.br
.SS "Install"
Install with \fRnpm\fP:

.PP
.PP
.nf
npm install \-\-save picomatch
.fi
.PP

.PP

.br
.SS "Usage"
The main export is a function that takes a glob pattern and an options object and returns a function for matching strings\&.

.PP
.PP
.nf
const pm = require('picomatch');
const isMatch = pm('*\&.js');

console\&.log(isMatch('abcd')); //=> false
console\&.log(isMatch('a\&.js')); //=> true
console\&.log(isMatch('a\&.md')); //=> false
console\&.log(isMatch('a/b\&.js')); //=> false
.fi
.PP

.PP

.br
.SS "API"
.SS "\fRpicomatch\fP"
Creates a matcher function from one or more glob patterns\&. The returned function takes a string to match as its first argument, and returns true if the string is a match\&. The returned matcher function also takes a boolean as the second argument that, when true, returns an object with additional information\&.

.PP
\fBParams\fP

.PP
.IP "\(bu" 2
\fRglobs\fP **{String|Array}**: One or more glob patterns\&.
.IP "\(bu" 2
\fRoptions\fP **{Object=}**
.IP "\(bu" 2
\fRreturns\fP **{Function=}**: Returns a matcher function\&.
.PP

.PP
\fBExample\fP

.PP
.PP
.nf
const picomatch = require('picomatch');
// picomatch(glob[, options]);

const isMatch = picomatch('*\&.!(*a)');
console\&.log(isMatch('a\&.a')); //=> false
console\&.log(isMatch('a\&.b')); //=> true
.fi
.PP
.SS "\fR\&.test\fP"
Test \fRinput\fP with the given \fRregex\fP\&. This is used by the main \fRpicomatch()\fP function to test the input string\&.

.PP
\fBParams\fP

.PP
.IP "\(bu" 2
\fRinput\fP **{String}**: String to test\&.
.IP "\(bu" 2
\fRregex\fP **{RegExp}**
.IP "\(bu" 2
\fRreturns\fP **{Object}**: Returns an object with matching info\&.
.PP

.PP
\fBExample\fP

.PP
.PP
.nf
const picomatch = require('picomatch');
// picomatch\&.test(input, regex[, options]);

console\&.log(picomatch\&.test('foo/bar', /^(?:([^/]*?)\\/([^/]*?))$/));
// { isMatch: true, match: [ 'foo/', 'foo', 'bar' ], output: 'foo/bar' }
.fi
.PP
.SS "\fR\&.matchBase\fP"
Match the basename of a filepath\&.

.PP
\fBParams\fP

.PP
.IP "\(bu" 2
\fRinput\fP **{String}**: String to test\&.
.IP "\(bu" 2
\fRglob\fP **{RegExp|String}**: Glob pattern or regex created by \fB\&.makeRe\fP\&.
.IP "\(bu" 2
\fRreturns\fP **{Boolean}**
.PP

.PP
\fBExample\fP

.PP
.PP
.nf
const picomatch = require('picomatch');
// picomatch\&.matchBase(input, glob[, options]);
console\&.log(picomatch\&.matchBase('foo/bar\&.js', '*\&.js'); // true
.fi
.PP
.SS "\fR\&.isMatch\fP"
Returns true if \fBany\fP of the given glob \fRpatterns\fP match the specified \fRstring\fP\&.

.PP
\fBParams\fP

.PP
.IP "\(bu" 2
**{String|Array}**: str The string to test\&.
.IP "\(bu" 2
**{String|Array}**: patterns One or more glob patterns to use for matching\&.
.IP "\(bu" 2
**{Object}**: See available \fBoptions\fP\&.
.IP "\(bu" 2
\fRreturns\fP **{Boolean}**: Returns true if any patterns match \fRstr\fP
.PP

.PP
\fBExample\fP

.PP
.PP
.nf
const picomatch = require('picomatch');
// picomatch\&.isMatch(string, patterns[, options]);

console\&.log(picomatch\&.isMatch('a\&.a', ['b\&.*', '*\&.a'])); //=> true
console\&.log(picomatch\&.isMatch('a\&.a', 'b\&.*')); //=> false
.fi
.PP
.SS "\fR\&.parse\fP"
Parse a glob pattern to create the source string for a regular expression\&.

.PP
\fBParams\fP

.PP
.IP "\(bu" 2
\fRpattern\fP **{String}**
.IP "\(bu" 2
\fRoptions\fP **{Object}**
.IP "\(bu" 2
\fRreturns\fP **{Object}**: Returns an object with useful properties and output to be used as a regex source string\&.
.PP

.PP
\fBExample\fP

.PP
.PP
.nf
const picomatch = require('picomatch');
const result = picomatch\&.parse(pattern[, options]);
.fi
.PP
.SS "\fR\&.scan\fP"
Scan a glob pattern to separate the pattern into segments\&.

.PP
\fBParams\fP

.PP
.IP "\(bu" 2
\fRinput\fP **{String}**: Glob pattern to scan\&.
.IP "\(bu" 2
\fRoptions\fP **{Object}**
.IP "\(bu" 2
\fRreturns\fP **{Object}**: Returns an object with
.PP

.PP
\fBExample\fP

.PP
.PP
.nf
const picomatch = require('picomatch');
// picomatch\&.scan(input[, options]);

const result = picomatch\&.scan('!\&./foo/*\&.js');
console\&.log(result);
{ prefix: '!\&./',
  input: '!\&./foo/*\&.js',
  start: 3,
  base: 'foo',
  glob: '*\&.js',
  isBrace: false,
  isBracket: false,
  isGlob: true,
  isExtglob: false,
  isGlobstar: false,
  negated: true }
.fi
.PP
.SS "\fR\&.compileRe\fP"
Compile a regular expression from the \fRstate\fP object returned by the \fBparse()\fP method\&.

.PP
\fBParams\fP

.PP
.IP "\(bu" 2
\fRstate\fP **{Object}**
.IP "\(bu" 2
\fRoptions\fP **{Object}**
.IP "\(bu" 2
\fRreturnOutput\fP **{Boolean}**: Intended for implementors, this argument allows you to return the raw output from the parser\&.
.IP "\(bu" 2
\fRreturnState\fP **{Boolean}**: Adds the state to a \fRstate\fP property on the returned regex\&. Useful for implementors and debugging\&.
.IP "\(bu" 2
\fRreturns\fP **{RegExp}**
.PP
.SS "\fR\&.makeRe\fP"
Create a regular expression from a parsed glob pattern\&.

.PP
\fBParams\fP

.PP
.IP "\(bu" 2
\fRstate\fP **{String}**: The object returned from the \fR\&.parse\fP method\&.
.IP "\(bu" 2
\fRoptions\fP **{Object}**
.IP "\(bu" 2
\fRreturnOutput\fP **{Boolean}**: Implementors may use this argument to return the compiled output, instead of a regular expression\&. This is not exposed on the options to prevent end-users from mutating the result\&.
.IP "\(bu" 2
\fRreturnState\fP **{Boolean}**: Implementors may use this argument to return the state from the parsed glob with the returned regular expression\&.
.IP "\(bu" 2
\fRreturns\fP **{RegExp}**: Returns a regex created from the given pattern\&.
.PP

.PP
\fBExample\fP

.PP
.PP
.nf
const picomatch = require('picomatch');
const state = picomatch\&.parse('*\&.js');
// picomatch\&.compileRe(state[, options]);

console\&.log(picomatch\&.compileRe(state));
//=> /^(?:(?!\\\&.)(?=\&.)[^/]*?\\\&.js)$/
.fi
.PP
.SS "\fR\&.toRegex\fP"
Create a regular expression from the given regex source string\&.

.PP
\fBParams\fP

.PP
.IP "\(bu" 2
\fRsource\fP **{String}**: Regular expression source string\&.
.IP "\(bu" 2
\fRoptions\fP **{Object}**
.IP "\(bu" 2
\fRreturns\fP **{RegExp}**
.PP

.PP
\fBExample\fP

.PP
.PP
.nf
const picomatch = require('picomatch');
// picomatch\&.toRegex(source[, options]);

const { output } = picomatch\&.parse('*\&.js');
console\&.log(picomatch\&.toRegex(output));
//=> /^(?:(?!\\\&.)(?=\&.)[^/]*?\\\&.js)$/
.fi
.PP

.PP

.br
.SS "Options"
.SS "Picomatch options"
The following options may be used with the main \fRpicomatch()\fP function or any of the methods on the picomatch API\&.

.PP
\fBOption\fP  \fBType\fP  \fBDefault value\fP  \fBDescription\fP  \fRbasename\fP  \fRboolean\fP  \fRfalse\fP  If set, then patterns without slashes will be matched against the basename of the path if it contains slashes\&. For example, \fRa?b\fP would match the path \fR/xyz/123/acb\fP, but not \fR/xyz/acb/123\fP\&.  \fRbash\fP  \fRboolean\fP  \fRfalse\fP  Follow bash matching rules more strictly - disallows backslashes as escape characters, and treats single stars as globstars (\fR**\fP)\&.  \fRcapture\fP  \fRboolean\fP  \fRundefined\fP  Return regex matches in supporting methods\&.  \fRcontains\fP  \fRboolean\fP  \fRundefined\fP  Allows glob to match any part of the given string(s)\&.  \fRcwd\fP  \fRstring\fP  \fRprocess\&.cwd()\fP  Current working directory\&. Used by \fRpicomatch\&.split()\fP  \fRdebug\fP  \fRboolean\fP  \fRundefined\fP  Debug regular expressions when an error is thrown\&.  \fRdot\fP  \fRboolean\fP  \fRfalse\fP  Enable dotfile matching\&. By default, dotfiles are ignored unless a \fR\&.\fP is explicitly defined in the pattern, or \fRoptions\&.dot\fP is true  \fRexpandRange\fP  \fRfunction\fP  \fRundefined\fP  Custom function for expanding ranges in brace patterns, such as \fR{a\&.\&.z}\fP\&. The function receives the range values as two arguments, and it must return a string to be used in the generated regex\&. It's recommended that returned strings be wrapped in parentheses\&.  \fRfailglob\fP  \fRboolean\fP  \fRfalse\fP  Throws an error if no matches are found\&. Based on the bash option of the same name\&.  \fRfastpaths\fP  \fRboolean\fP  \fRtrue\fP  To speed up processing, full parsing is skipped for a handful common glob patterns\&. Disable this behavior by setting this option to \fRfalse\fP\&.  \fRflags\fP  \fRstring\fP  \fRundefined\fP  Regex flags to use in the generated regex\&. If defined, the \fRnocase\fP option will be overridden\&.  \fBformat\fP  \fRfunction\fP  \fRundefined\fP  Custom function for formatting the returned string\&. This is useful for removing leading slashes, converting Windows paths to Posix paths, etc\&.  \fRignore\fP  \fRarray\\|string\fP  \fRundefined\fP  One or more glob patterns for excluding strings that should not be matched from the result\&.  \fRkeepQuotes\fP  \fRboolean\fP  \fRfalse\fP  Retain quotes in the generated regex, since quotes may also be used as an alternative to backslashes\&.  \fRliteralBrackets\fP  \fRboolean\fP  \fRundefined\fP  When \fRtrue\fP, brackets in the glob pattern will be escaped so that only literal brackets will be matched\&.  \fRmatchBase\fP  \fRboolean\fP  \fRfalse\fP  Alias for \fRbasename\fP  \fRmaxLength\fP  \fRboolean\fP  \fR65536\fP  Limit the max length of the input string\&. An error is thrown if the input string is longer than this value\&.  \fRnobrace\fP  \fRboolean\fP  \fRfalse\fP  Disable brace matching, so that \fR{a,b}\fP and \fR{1\&.\&.3}\fP would be treated as literal characters\&.  \fRnobracket\fP  \fRboolean\fP  \fRundefined\fP  Disable matching with regex brackets\&.  \fRnocase\fP  \fRboolean\fP  \fRfalse\fP  Make matching case-insensitive\&. Equivalent to the regex \fRi\fP flag\&. Note that this option is overridden by the \fRflags\fP option\&.  \fRnodupes\fP  \fRboolean\fP  \fRtrue\fP  Deprecated, use \fRnounique\fP instead\&. This option will be removed in a future major release\&. By default duplicates are removed\&. Disable uniquification by setting this option to false\&.  \fRnoext\fP  \fRboolean\fP  \fRfalse\fP  Alias for \fRnoextglob\fP  \fRnoextglob\fP  \fRboolean\fP  \fRfalse\fP  Disable support for matching with extglobs (like \fR+(a\\|b)\fP)  \fRnoglobstar\fP  \fRboolean\fP  \fRfalse\fP  Disable support for matching nested directories with globstars (\fR**\fP)  \fRnonegate\fP  \fRboolean\fP  \fRfalse\fP  Disable support for negating with leading \fR!\fP  \fRnoquantifiers\fP  \fRboolean\fP  \fRfalse\fP  Disable support for regex quantifiers (like \fRa{1,2}\fP) and treat them as brace patterns to be expanded\&.  \fBonIgnore\fP  \fRfunction\fP  \fRundefined\fP  Function to be called on ignored items\&.  \fBonMatch\fP  \fRfunction\fP  \fRundefined\fP  Function to be called on matched items\&.  \fBonResult\fP  \fRfunction\fP  \fRundefined\fP  Function to be called on all items, regardless of whether or not they are matched or ignored\&.  \fRposix\fP  \fRboolean\fP  \fRfalse\fP  Support POSIX character classes ("posix brackets")\&.  \fRposixSlashes\fP  \fRboolean\fP  \fRundefined\fP  Convert all slashes in file paths to forward slashes\&. This does not convert slashes in the glob pattern itself  \fRprepend\fP  \fRboolean\fP  \fRundefined\fP  String to prepend to the generated regex used for matching\&.  \fRregex\fP  \fRboolean\fP  \fRfalse\fP  Use regular expression rules for \fR+\fP (instead of matching literal \fR+\fP), and for stars that follow closing parentheses or brackets (as in \fR)*\fP and \fR]*\fP)\&.  \fRstrictBrackets\fP  \fRboolean\fP  \fRundefined\fP  Throw an error if brackets, braces, or parens are imbalanced\&.  \fRstrictSlashes\fP  \fRboolean\fP  \fRundefined\fP  When true, picomatch won't match trailing slashes with single stars\&.  \fRunescape\fP  \fRboolean\fP  \fRundefined\fP  Remove backslashes preceding escaped characters in the glob pattern\&. By default, backslashes are retained\&.  \fRunixify\fP  \fRboolean\fP  \fRundefined\fP  Alias for \fRposixSlashes\fP, for backwards compatibility\&.  

.PP
picomatch has automatic detection for regex positive and negative lookbehinds\&. If the pattern contains a negative lookbehind, you must be using Node\&.js >= 8\&.10 or else picomatch will throw an error\&.
.SS "Scan Options"
In addition to the main \fBpicomatch options\fP, the following options may also be used with the \fB\&.scan\fP method\&.

.PP
\fBOption\fP  \fBType\fP  \fBDefault value\fP  \fBDescription\fP  \fRtokens\fP  \fRboolean\fP  \fRfalse\fP  When \fRtrue\fP, the returned object will include an array of tokens (objects), representing each path "segment" in the scanned glob pattern  \fRparts\fP  \fRboolean\fP  \fRfalse\fP  When \fRtrue\fP, the returned object will include an array of strings representing each path "segment" in the scanned glob pattern\&. This is automatically enabled when \fRoptions\&.tokens\fP is true  

.PP
\fBExample\fP

.PP
.PP
.nf
const picomatch = require('picomatch');
const result = picomatch\&.scan('!\&./foo/*\&.js', { tokens: true });
console\&.log(result);
// {
//   prefix: '!\&./',
//   input: '!\&./foo/*\&.js',
//   start: 3,
//   base: 'foo',
//   glob: '*\&.js',
//   isBrace: false,
//   isBracket: false,
//   isGlob: true,
//   isExtglob: false,
//   isGlobstar: false,
//   negated: true,
//   maxDepth: 2,
//   tokens: [
//     { value: '!\&./', depth: 0, isGlob: false, negated: true, isPrefix: true },
//     { value: 'foo', depth: 1, isGlob: false },
//     { value: '*\&.js', depth: 1, isGlob: true }
//   ],
//   slashes: [ 2, 6 ],
//   parts: [ 'foo', '*\&.js' ]
// }
.fi
.PP

.PP

.br
.SS "Options Examples"
.SS "options\&.expandRange"
\fBType\fP: \fRfunction\fP

.PP
\fBDefault\fP: \fRundefined\fP

.PP
Custom function for expanding ranges in brace patterns\&. The \fRfill-range\fP library is ideal for this purpose, or you can use custom code to do whatever you need\&.

.PP
\fBExample\fP

.PP
The following example shows how to create a glob that matches a folder

.PP
.PP
.nf
const fill = require('fill\-range');
const regex = pm\&.makeRe('foo/{01\&.\&.25}/bar', {
  expandRange(a, b) {
    return `(${fill(a, b, { toRegex: true })})`;
  }
});

console\&.log(regex);
//=> /^(?:foo\\/((?:0[1\-9]|1[0\-9]|2[0\-5]))\\/bar)$/

console\&.log(regex\&.test('foo/00/bar'))  // false
console\&.log(regex\&.test('foo/01/bar'))  // true
console\&.log(regex\&.test('foo/10/bar')) // true
console\&.log(regex\&.test('foo/22/bar')) // true
console\&.log(regex\&.test('foo/25/bar')) // true
console\&.log(regex\&.test('foo/26/bar')) // false
.fi
.PP
.SS "options\&.format"
\fBType\fP: \fRfunction\fP

.PP
\fBDefault\fP: \fRundefined\fP

.PP
Custom function for formatting strings before they're matched\&.

.PP
\fBExample\fP

.PP
.PP
.nf
// strip leading '\&./' from strings
const format = str => str\&.replace(/^\\\&.\\//, '');
const isMatch = picomatch('foo/*\&.js', { format });
console\&.log(isMatch('\&./foo/bar\&.js')); //=> true
.fi
.PP
.SS "options\&.onMatch"
.PP
.nf
const onMatch = ({ glob, regex, input, output }) => {
  console\&.log({ glob, regex, input, output });
};

const isMatch = picomatch('*', { onMatch });
isMatch('foo');
isMatch('bar');
isMatch('baz');
.fi
.PP
.SS "options\&.onIgnore"
.PP
.nf
const onIgnore = ({ glob, regex, input, output }) => {
  console\&.log({ glob, regex, input, output });
};

const isMatch = picomatch('*', { onIgnore, ignore: 'f*' });
isMatch('foo');
isMatch('bar');
isMatch('baz');
.fi
.PP
.SS "options\&.onResult"
.PP
.nf
const onResult = ({ glob, regex, input, output }) => {
  console\&.log({ glob, regex, input, output });
};

const isMatch = picomatch('*', { onResult, ignore: 'f*' });
isMatch('foo');
isMatch('bar');
isMatch('baz');
.fi
.PP

