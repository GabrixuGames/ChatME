.SH NAME
frontend/node_modules/normalize-range Directory Reference
.SH SYNOPSIS
.br
.PP
.SH "Detailed Description"
.PP 

.SH "normalize-range"
.PP
Utility for normalizing a numeric range, with a wrapping function useful for polar coordinates\&.

.PP
\fR\fP \fR\fP \fR\fP \fR\fP \fR\fP

.PP
\fR\fP.SH "Usage"
.PP
.PP
.nf
var nr = require('normalize\-range');

nr\&.wrap(0, 360, 400);
//=> 40

nr\&.wrap(0, 360, \-90);
//=> 270

nr\&.limit(0, 100, 500);
//=> 100

nr\&.limit(0, 100, \-20);
//=> 0

// There is a convenient currying function
var wrapAngle = nr\&.curry(0, 360)\&.wrap;
var limitTo10 = nr\&.curry(0, 10)\&.limit;

wrapAngle(\-30);
//=> 330
.fi
.PP
 
.SH "API"
.PP
.SS "wrap(min, max, value)"
Normalizes a values that "wraps around"\&. For example, in a polar coordinate system, 270˚ can also be represented as -90˚\&. For wrapping purposes we assume \fRmax\fP is functionally equivalent to \fRmin\fP, and that \fRwrap(max + 1) === wrap(min + 1)\fP\&. Wrap always assumes that \fRmin\fP is \fIinclusive\fP, and \fRmax\fP is \fIexclusive\fP\&. In other words, if \fRvalue === max\fP the function will wrap it, and return \fRmin\fP, but \fRmin\fP will not be wrapped\&.

.PP
.PP
.nf
nr\&.wrap(0, 360, 0) === 0;
nr\&.wrap(0, 360, 360) === 0;
nr\&.wrap(0, 360, 361) === 1;
nr\&.wrap(0, 360, \-1) === 359;
.fi
.PP

.PP
You are not restricted to whole numbers, and ranges can be negative\&.

.PP
.PP
.nf
var π = Math\&.PI;
var radianRange = nr\&.curry(\-π, π);

redianRange\&.wrap(0) === 0;
nr\&.wrap(π) === \-π;
nr\&.wrap(4 * π / 3) === \-2 * π / 3;
.fi
.PP
.SS "limit(min, max, value)"
Normalize the value by bringing it within the range\&. If \fRvalue\fP is greater than \fRmax\fP, \fRmax\fP will be returned\&. If \fRvalue\fP is less than \fRmin\fP, \fRmin\fP will be returned\&. Otherwise, \fRvalue\fP is returned unaltered\&. Both ends of this range are \fIinclusive\fP\&.
.SS "test(min, max, value, [minExclusive], [maxExclusive])"
Returns \fRtrue\fP if \fRvalue\fP is within the range, \fRfalse\fP otherwise\&. It defaults to \fRinclusive\fP on both ends of the range, but that can be changed by setting \fRminExclusive\fP and/or \fRmaxExclusive\fP to a truthy value\&.
.SS "validate(min, max, value, [minExclusive], [maxExclusive])"
Returns \fRvalue\fP or throws an error if \fRvalue\fP is outside the specified range\&.
.SS "name(min, max, value, [minExclusive], [maxExclusive])"
Returns a string representing this range in \fRrange notation\fP\&.
.SS "curry(min, max, [minExclusive], [maxExclusive])"
Convenience method for currying all method arguments except \fRvalue\fP\&.

.PP
.PP
.nf
var angle = require('normalize\-range')\&.curry(\-180, 180, false, true);

angle\&.wrap(270)
//=> \-90

angle\&.limit(200)
//=> 180

angle\&.test(0)
//=> true

angle\&.validate(300)
//=> throws an Error

angle\&.toString() // or angle\&.name()
//=> "[\-180,180)"
.fi
.PP
.SS "min"
\fIRequired\fP 
.br
 Type: \fRnumber\fP

.PP
The minimum value (inclusive) of the range\&.
.SS "max"
\fIRequired\fP 
.br
 Type: \fRnumber\fP

.PP
The maximum value (exclusive) of the range\&.
.SS "value"
\fIRequired\fP 
.br
 Type: \fRnumber\fP

.PP
The value to be normalized\&.
.SS "returns"
Type: \fRnumber\fP

.PP
The normalized value\&.
