.PP
.SH "Detailed Description"
.PP 

.SH "read-cache [![Build Status](https://travis-ci.org/TrySound/read-cache.svg?branch=master)](https://travis-ci.org/TrySound/read-cache)"
.PP
Reads and caches the entire contents of a file until it is modified\&.
.SH "Install"
.PP
.PP
.nf
$ npm i read\-cache
.fi
.PP
.SH "Usage"
.PP
.PP
.nf
// foo\&.js
var readCache = require('read\-cache');

readCache('foo\&.js')\&.then(function (contents) {
    console\&.log(contents);
});
.fi
.PP
.SH "API"
.PP
.SS "readCache(path[, encoding])"
Returns a promise that resolves with the file's contents\&.
.SS "readCache\&.sync(path[, encoding])"
Returns the content of the file\&.
.SS "readCache\&.get(path[, encoding])"
Returns the content of cached file or null\&.
.SS "readCache\&.clear()"
Clears the contents of the cache\&.
