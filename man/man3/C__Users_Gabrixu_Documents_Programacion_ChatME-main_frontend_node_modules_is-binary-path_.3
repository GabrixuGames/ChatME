.SH "Detailed Description"
.PP 

.SH "is-binary-path [![Build Status](https://travis-ci.org/sindresorhus/is-binary-path.svg?branch=master)](https://travis-ci.org/sindresorhus/is-binary-path)"
.PP
.RS 4
Check if a file path is a binary file 
.RE
.PP
.SH "Install"
.PP
.PP
.nf
$ npm install is\-binary\-path
.fi
.PP
.SH "Usage"
.PP
.PP
.nf
const isBinaryPath = require('is\-binary\-path');

isBinaryPath('source/unicorn\&.png');
//=> true

isBinaryPath('source/unicorn\&.txt');
//=> false
.fi
.PP
