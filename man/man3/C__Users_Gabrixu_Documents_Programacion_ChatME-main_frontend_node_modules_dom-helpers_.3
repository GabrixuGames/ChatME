.IP "  \(bu" 4
\fRcontains(container, element)\fP
.IP "  \(bu" 4
\fRheight(element, useClientHeight)\fP
.IP "  \(bu" 4
\fRwidth(element, useClientWidth)\fP
.IP "  \(bu" 4
\fRmatches(element, selector)\fP
.IP "  \(bu" 4
\fRoffset(element)\fP -> \fR{ top: Number, left: Number, height: Number, width: Number}\fP
.IP "  \(bu" 4
\fRoffsetParent(element)\fP: return the parent node that the element is offset from
.IP "  \(bu" 4
\fRposition(element, [offsetParent]\fP: return "offset" of the node to its offsetParent, optionally you can specify the offset parent if different than the "real" one
.IP "  \(bu" 4
\fRscrollTop(element, [value])\fP
.IP "  \(bu" 4
\fRscrollLeft(element, [value])\fP
.IP "  \(bu" 4
\fRscrollParent(element)\fP
.IP "  \(bu" 4
