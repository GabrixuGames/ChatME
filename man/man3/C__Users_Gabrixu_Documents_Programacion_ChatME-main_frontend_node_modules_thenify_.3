.SH NAME
frontend/node_modules/thenify Directory Reference
.SH SYNOPSIS
.br
.PP
.SH "Detailed Description"
.PP 

.SH "thenify"
.PP
\fR\fP \fR\fP \fR\fP \fR\fP [][license-url] \fR\fP

.PP
Promisify a callback-based function using \fR\fRany-promise\fP\fP\&.

.PP
.IP "\(bu" 2
Preserves function names
.IP "\(bu" 2
Uses a native promise implementation if available and tries to fall back to a promise implementation such as \fRbluebird\fP
.IP "\(bu" 2
Converts multiple arguments from the callback into an \fRArray\fP, also support change the behavior by \fRoptions\&.multiArgs\fP
.IP "\(bu" 2
Resulting function never deoptimizes
.IP "\(bu" 2
Supports both callback and promise style
.PP

.PP
An added benefit is that \fRthrow\fPn errors in that async function will be caught by the promise!
.SH "API"
.PP
.SS "fn = thenify(fn, options)"
Promisifies a function\&.
.SS "Options"
\fRoptions\fP are optional\&.

.PP
.IP "\(bu" 2
\fRoptions\&.withCallback\fP - support both callback and promise style, default to \fRfalse\fP\&.
.IP "\(bu" 2
\fRoptions\&.multiArgs\fP - change the behavior when callback have multiple arguments\&. default to \fRtrue\fP\&.
.IP "  \(bu" 4
\fRtrue\fP - converts multiple arguments to an array
.IP "  \(bu" 4
\fRfalse\fP- always use the first argument
.IP "  \(bu" 4
\fRArray\fP - converts multiple arguments to an object with keys provided in \fRoptions\&.multiArgs\fP
.PP

.IP "\(bu" 2
Turn async functions into promises
.PP

.PP
.PP
.nf
var thenify = require('thenify');

var somethingAsync = thenify(function somethingAsync(a, b, c, callback) {
  callback(null, a, b, c);
});
.fi
.PP

.PP
.IP "\(bu" 2
Backward compatible with callback
.PP

.PP
.PP
.nf
var thenify = require('thenify');

var somethingAsync = thenify(function somethingAsync(a, b, c, callback) {
  callback(null, a, b, c);
}, { withCallback: true });

// somethingAsync(a, b, c)\&.then(onFulfilled)\&.catch(onRejected);
// somethingAsync(a, b, c, function () {});
.fi
.PP

.PP
or use \fRthenify\&.withCallback()\fP

.PP
.PP
.nf
var thenify = require('thenify')\&.withCallback;

var somethingAsync = thenify(function somethingAsync(a, b, c, callback) {
  callback(null, a, b, c);
});

// somethingAsync(a, b, c)\&.then(onFulfilled)\&.catch(onRejected);
// somethingAsync(a, b, c, function () {});
.fi
.PP

.PP
.IP "\(bu" 2
Always return the first argument in callback
.PP

.PP
.PP
.nf
var thenify = require('thenify');

var promise = thenify(function (callback) {
  callback(null, 1, 2, 3);
}, { multiArgs: false });

// promise()\&.then(function onFulfilled(value) {
//   assert\&.equal(value, 1);
// });
.fi
.PP

.PP
.IP "\(bu" 2
Converts callback arguments to an object
.PP

.PP
.PP
.nf
var thenify = require('thenify');

var promise = thenify(function (callback) {
  callback(null, 1, 2, 3);
}, { multiArgs: [ 'one', 'tow', 'three' ] });

// promise()\&.then(function onFulfilled(value) {
//   assert\&.deepEqual(value, {
//     one: 1,
//     tow: 2,
//     three: 3
//   });
// });
.fi
.PP
 
