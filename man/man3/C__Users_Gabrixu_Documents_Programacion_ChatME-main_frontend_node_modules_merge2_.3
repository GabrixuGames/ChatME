.SH NAME
frontend/node_modules/merge2 Directory Reference
.SH SYNOPSIS
.br
.PP
.SH "Detailed Description"
.PP 

.SH "merge2"
.PP
Merge multiple streams into one stream in sequence or parallel\&.

.PP
\fR\fP \fR\fP \fR\fP
.SH "Install"
.PP
Install with \fRnpm\fP

.PP
.PP
.nf
npm install merge2
.fi
.PP
.SH "Usage"
.PP
.PP
.nf
const gulp = require('gulp')
const merge2 = require('merge2')
const concat = require('gulp\-concat')
const minifyHtml = require('gulp\-minify\-html')
const ngtemplate = require('gulp\-ngtemplate')

gulp\&.task('app\-js', function () {
  return merge2(
      gulp\&.src('static/src/tpl/*\&.html')
        \&.pipe(minifyHtml({empty: true}))
        \&.pipe(ngtemplate({
          module: 'genTemplates',
          standalone: true
        })
      ), gulp\&.src([
        'static/src/js/app\&.js',
        'static/src/js/locale_zh\-cn\&.js',
        'static/src/js/router\&.js',
        'static/src/js/tools\&.js',
        'static/src/js/services\&.js',
        'static/src/js/filters\&.js',
        'static/src/js/directives\&.js',
        'static/src/js/controllers\&.js'
      ])
    )
    \&.pipe(concat('app\&.js'))
    \&.pipe(gulp\&.dest('static/dist/js/'))
})
.fi
.PP

.PP
.PP
.nf
const stream = merge2([stream1, stream2], stream3, {end: false})
//\&.\&.\&.
stream\&.add(stream4, stream5)
//\&.\&.
stream\&.end()
.fi
.PP

.PP
.PP
.nf
// equal to merge2([stream1, stream2], stream3)
const stream = merge2()
stream\&.add([stream1, stream2])
stream\&.add(stream3)
.fi
.PP

.PP
.PP
.nf
// merge order:
//   1\&. merge `stream1`;
//   2\&. merge `stream2` and `stream3` in parallel after `stream1` merged;
//   3\&. merge 'stream4' after `stream2` and `stream3` merged;
const stream = merge2(stream1, [stream2, stream3], stream4)

// merge order:
//   1\&. merge `stream5` and `stream6` in parallel after `stream4` merged;
//   2\&. merge 'stream7' after `stream5` and `stream6` merged;
stream\&.add([stream5, stream6], stream7)
.fi
.PP

.PP
.PP
.nf
// nest merge
// equal to merge2(stream1, stream2, stream6, stream3, [stream4, stream5]);
const streamA = merge2(stream1, stream2)
const streamB = merge2(stream3, [stream4, stream5])
const stream = merge2(streamA, streamB)
streamA\&.add(stream6)
.fi
.PP
.SH "API"
.PP
.PP
.nf
const merge2 = require('merge2')
.fi
.PP
.SS "merge2()"
.SS "merge2(options)"
.SS "merge2(stream1, stream2, \&.\&.\&., streamN)"
.SS "merge2(stream1, stream2, \&.\&.\&., streamN, options)"
.SS "merge2(stream1, [stream2, stream3, \&.\&.\&.], streamN, options)"
return a duplex stream (mergedStream)\&. streams in array will be merged in parallel\&.
.SS "mergedStream\&.add(stream)"
.SS "mergedStream\&.add(stream1, [stream2, stream3, \&.\&.\&.], \&.\&.\&.)"
return the mergedStream\&.
.SS "mergedStream\&.on('queueDrain', function() {})"
It will emit 'queueDrain' when all streams merged\&. If you set \fRend === false\fP in options, this event give you a notice that should add more streams to merge or end the mergedStream\&.
.SS "stream"
\fIoption\fP Type: \fRReadable\fP or \fRDuplex\fP or \fRTransform\fP stream\&.
.SS "options"
\fIoption\fP Type: \fRObject\fP\&.

.PP
.IP "\(bu" 2
\fBend\fP - \fRBoolean\fP - if \fRend === false\fP then mergedStream will not be auto ended, you should end by yourself\&. \fBDefault:\fP \fRundefined\fP
.IP "\(bu" 2
\fBpipeError\fP - \fRBoolean\fP - if \fRpipeError === true\fP then mergedStream will emit \fRerror\fP event from source streams\&. \fBDefault:\fP \fRundefined\fP
.IP "\(bu" 2
\fBobjectMode\fP - \fRBoolean\fP \&. \fBDefault:\fP \fRtrue\fP
.PP

.PP
\fRobjectMode\fP and other options(\fRhighWaterMark\fP, \fRdefaultEncoding\fP \&.\&.\&.) is same as Node\&.js \fRStream\fP\&.
