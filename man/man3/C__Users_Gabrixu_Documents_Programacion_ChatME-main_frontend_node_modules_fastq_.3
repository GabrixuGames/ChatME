.SH "Install"
.PP
\fRnpm i fastq --save\fP
.SH "Usage (callback API)"
.PP
.PP
.nf
'use strict'

const queue = require('fastq')(worker, 1)

queue\&.push(42, function (err, result) {
  if (err) { throw err }
  console\&.log('the result is', result)
})

function worker (arg, cb) {
  cb(null, arg * 2)
}
.fi
.PP
.SH "Usage (promise API)"
.PP
.PP
.nf
const queue = require('fastq')\&.promise(worker, 1)

async function worker (arg) {
  return arg * 2
}

async function run () {
  const result = await queue\&.push(42)
  console\&.log('the result is', result)
}

run()
.fi
.PP
.SS "Setting "this""
.PP
.nf
'use strict'

const that = { hello: 'world' }
const queue = require('fastq')(that, worker, 1)

queue\&.push(42, function (err, result) {
  if (err) { throw err }
  console\&.log(this)
  console\&.log('the result is', result)
})

function worker (arg, cb) {
  console\&.log(this)
  cb(null, arg * 2)
}
.fi
.PP
.SS "Using with TypeScript (callback API)"
.PP
.nf
'use strict'

import * as fastq from "fastq";
import type { queue, done } from "fastq";

type Task = {
  id: number
}

const q: queue<Task> = fastq(worker, 1)

q\&.push({ id: 42})

function worker (arg: Task, cb: done) {
  console\&.log(arg\&.id)
  cb(null)
}
.fi
.PP
.SS "Using with TypeScript (promise API)"
.PP
.nf
'use strict'

import * as fastq from "fastq";
import type { queueAsPromised } from "fastq";

type Task = {
  id: number
}

const q: queueAsPromised<Task> = fastq\&.promise(asyncWorker, 1)

q\&.push({ id: 42})\&.catch((err) => console\&.error(err))

async function asyncWorker (arg: Task): Promise<void> {
  // No need for a try\-catch block, fastq handles errors automatically
  console\&.log(arg\&.id)
}
.fi
.PP
