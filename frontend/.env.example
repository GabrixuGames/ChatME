# Frontend Environment Variables
# Copia este archivo a .env y configura tus valores

# Backend API URL
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000

# Para red local (opcional):
# VITE_API_URL=http://[TU_IP_LOCAL]:5000
# VITE_SOCKET_URL=http://[TU_IP_LOCAL]:5000

# Para producción:
# VITE_API_URL=https://tu-api-backend.com
# VITE_SOCKET_URL=https://tu-api-backend.com